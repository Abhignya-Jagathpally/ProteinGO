# Default: ignore heavy run artifacts; keep small result docs tracked via root rules.
*
!.gitignore
!*.sh
!final/
!final/**
!phaseA/
!phaseA/RESULTS.md
!phaseA/*.json
!phaseA/a2/
!phaseA/a2/**
!phaseA/a3/
!phaseA/a3/**
!baselines/
!baselines/**
!logs/
!logs/**
!analysis/
!analysis/**
!aux/
!aux/*.json
!aux/*.log

# Heavy types even in allowed dirs
**/*.pt
**/*.pth
**/*.ckpt
**/*.bin
**/*.safetensors
**/*.npy
**/*.npz
**/*.parquet
**/*.dmp
**/*.fa
**/*.fasta
**/*.obo
**/mmseqs_tmp/
**/search_tmp/
phaseA/pools/
phaseA/logs/
aux/raw/
analysis/**/tok/
